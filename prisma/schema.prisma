generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model WorkoutEntry {
  id        String   @id @default(cuid())
  date      DateTime
  type      String
  duration  Int
  intensity Int
  notes     String?
  createdAt DateTime @default(now())
}

model SleepEntry {
  id        String   @id @default(cuid())
  date      DateTime
  hours     Float
  quality   Int
  createdAt DateTime @default(now())
}

model WeightEntry {
  id        String   @id @default(cuid())
  date      DateTime
  weight    Float
  createdAt DateTime @default(now())
}

model DashboardCard {
  id         String   @id @default(cuid())
  title      String
  type       String
  config     String
  order      Int      @default(0)
  refreshSec Int      @default(60)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
